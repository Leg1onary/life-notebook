{
  "expo": {
    "name": "Life Notebook",
    "slug": "life-notebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171614"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ssholokhov.lifenotebook"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171614"
      },
      "package": "com.ssholokhov.lifenotebook"
    },
    "scheme": "life-notebook",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}